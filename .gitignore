# 📦 Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/

# 🛠️ Next.js Build & Outputs
/.next/
/out/
/.output
/build
/dist

# 📊 Testing & Reports
/coverage

# 📂 Dataset & Recording Outputs (Crucial!)
/output/

# 🔒 Local Environment Files (Secrets)
.env
.env.*
.env*.local

# 🔑 HTTPS Development Certificates
/certificates/
*.pem

# 💻 IDE & Text Editor Files
/.idea/
/.vscode/
*.code-workspace
*.sublime-project
*.sublime-workspace

# 🐛 Debug & Log Files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.tsbuildinfo

# 🍎 OS-Specific Files
.DS_Store
Thumbs.db
ehthumbs.db
.Spotlight-V100
.Trashes
*.swp
*.swo
*~

# ⚡ Vercel
.vercel

